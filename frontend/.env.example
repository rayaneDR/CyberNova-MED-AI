# Public frontend API endpoint. This is not a credential.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Mission UUID and optional initial astronaut UUID from backend seed-demo output.
NEXT_PUBLIC_MISSION_ID=
NEXT_PUBLIC_ASTRONAUT_ID=
# Canonical v1 source session UUID from seed-demo; never place a write token here.
NEXT_PUBLIC_SOURCE_SESSION_ID=
