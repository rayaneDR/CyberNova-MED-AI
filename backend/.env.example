DATABASE_URL=sqlite:///./cybernova.db
FRONTEND_ORIGIN=http://localhost:3000
# Optional for shared deployment. When configured, protect every write route.
WRITE_TOKEN=
# Set true only when binding on a trusted private network with WRITE_TOKEN set.
ALLOW_NON_LOOPBACK=false

# Non-clinical analytics demonstration settings. Tune only after team review.
ANALYTICS_HISTORY_WINDOW=30
ANALYTICS_MINIMUM_BASELINE=8
ANALYTICS_ROBUST_Z_THRESHOLD=3.5
ANALYTICS_BASELINE_GUARD_Z=2.5
ANALYTICS_EWMA_ALPHA=0.25
ANALYTICS_EWMA_Z_THRESHOLD=3.0
ANALYTICS_REQUIRED_CONSECUTIVE=3
