# Copy to frontend/.env.local for explicit Live API mode. Demo mode works without this file.
# Find UUIDs in the output of: backend/.venv/Scripts/python -m backend.app.cli seed-demo
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_MISSION_ID=
NEXT_PUBLIC_SOURCE_SESSION_ID=
# Optional: choose a roster entry returned by GET /astronauts.
NEXT_PUBLIC_ASTRONAUT_ID=
# Never place WRITE_TOKEN or other secrets in NEXT_PUBLIC_* variables.
